    join
        orders o1_0 
            on o1_0.id=oi1_0.order_id 
    join
        products p1_0 
            on p1_0.id=oi1_0.product_id 
    where
        o1_0.status<>'CANCELLED' 
        and o1_0.created_at>=? 
        and o1_0.created_at<=? 
    group by
        oi1_0.product_id,
        p1_0.name 
    order by
        sum(oi1_0.quantity) desc 
    limit
        ?
